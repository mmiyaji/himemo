{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HiMemo: start Android emulator",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\start_android_emulator.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "HiMemo: build production APK with .env",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\flutter_with_env.ps1",
        "build",
        "apk",
        "--flavor",
        "production",
        "-t",
        "lib/main_production.dart"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "HiMemo: build development APK with .env",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\flutter_with_env.ps1",
        "build",
        "apk",
        "--debug",
        "--flavor",
        "development",
        "-t",
        "lib/main_development.dart"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
